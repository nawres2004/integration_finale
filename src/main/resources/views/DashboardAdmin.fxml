<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.10" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.suivie_nawres.controllers.DashboardAdminController"
            styleClass="root">
    <left>
        <VBox prefWidth="260" spacing="16" styleClass="sidebar">
            <padding><Insets top="20" right="18" bottom="20" left="18"/></padding>
            <Label text="VitaPlus Medical" styleClass="app-title" wrapText="true"/>
            <Label text="Dashboard Admin" styleClass="app-subtitle"/>
            <Button text="Voir rendez-vous" onAction="#afficherRendezVous" maxWidth="1.7976931348623157E308" styleClass="primary-button"/>
            <Button text="Voir consultations" onAction="#afficherConsultations" maxWidth="1.7976931348623157E308" styleClass="secondary-button"/>
            <Button text="📊 Statistiques" onAction="#afficherStatistiques" maxWidth="1.7976931348623157E308" styleClass="primary-button"/>
        </VBox>
    </left>
    <top>
        <HBox spacing="12" styleClass="app-header">
            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
            <Label text="Administration" styleClass="app-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Changer le role" onAction="#retourChoixRole" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>
</BorderPane>

