<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.10" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.suivie_nawres.controllers.ChoixRoleController"
            styleClass="root">
    <center>
        <VBox spacing="16" alignment="CENTER" maxWidth="420" styleClass="card">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
            <Label text="VitaPlus Medical" styleClass="app-title"/>
            <Label text="Choisis ton rôle pour accéder à l'interface correspondante." styleClass="app-subtitle" wrapText="true"/>
            <Button text="Entrer en tant qu'Admin" onAction="#ouvrirAdmin" maxWidth="1.7976931348623157E308" styleClass="primary-button"/>
            <Button text="Entrer en tant que Patient" onAction="#ouvrirPatient" maxWidth="1.7976931348623157E308" styleClass="secondary-button"/>
            <Button text="Entrer en tant que Médecin" onAction="#ouvrirMedecin" maxWidth="1.7976931348623157E308" styleClass="secondary-button"/>
        </VBox>
    </center>
</BorderPane>

