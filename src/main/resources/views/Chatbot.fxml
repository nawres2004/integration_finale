<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.10" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.suivie_nawres.controllers.ChatbotController"
            styleClass="card"
            prefWidth="800" 
            prefHeight="600">
    
    <!-- En-tête -->
    <top>
        <VBox styleClass="chat-header">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="🤖 Assistant Médical VitaPlus" styleClass="chat-title"/>
                <Label fx:id="lblStatus" text="✅ Prêt" styleClass="chat-status"/>
                
                <!-- Spacer -->
                <HBox HBox.hgrow="ALWAYS"/>
                
                <Button text="🗑️ Effacer" 
                       onAction="#effacerConversation" 
                       styleClass="btn-secondary"/>
                <Button text="✖️ Fermer" 
                       onAction="#fermer" 
                       styleClass="btn-close"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Zone de chat -->
    <center>
        <ScrollPane fx:id="scrollPane" 
                   styleClass="chat-scroll"
                   fitToWidth="true"
                   hbarPolicy="NEVER"
                   vbarPolicy="ALWAYS">
            <VBox fx:id="chatContainer" 
                 styleClass="chat-container"
                 spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            </VBox>
        </ScrollPane>
    </center>
    
    <!-- Zone de saisie -->
    <bottom>
        <VBox styleClass="chat-input-area">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="txtMessage" 
                          promptText="💬 Posez votre question médicale..." 
                          styleClass="chat-input-field"
                          HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEnvoyer" 
                       text="📤 Envoyer" 
                       onAction="#envoyerMessage" 
                       styleClass="btn-primary"
                       defaultButton="true"/>
            </HBox>
            
            <Label text="⚠️ Les conseils du chatbot ne remplacent pas une consultation médicale réelle" 
                  styleClass="chat-disclaimer"/>
        </VBox>
    </bottom>
</BorderPane>
