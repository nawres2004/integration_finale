<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.10" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.suivie_nawres.controllers.AfficherRendezVousModerneController"
            styleClass="card">
    <top>
        <VBox spacing="16">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            
            <!-- Titre -->
            <Label text="📅 Mes Rendez-vous" styleClass="section-title"/>
            
            <!-- Barre de recherche -->
            <HBox spacing="10" styleClass="search-bar">
                <TextField fx:id="txtRechercheId" 
                          promptText="🔍 Rechercher par nom, prénom, notes..." 
                          styleClass="search-field-modern"
                          HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="comboFiltreStatut" 
                         promptText="Statut" 
                         styleClass="filter-combo"
                         prefWidth="150"/>
                <ComboBox fx:id="comboFiltreMode" 
                         promptText="Mode" 
                         styleClass="filter-combo"
                         prefWidth="170"/>
                <Button text="🔍 Rechercher" 
                       onAction="#rechercher" 
                       styleClass="btn-search"/>
                <Button text="↻ Reset" 
                       onAction="#reinitialiserFiltres" 
                       styleClass="btn-reset"/>
                <Button text="⟳ Actualiser" 
                       onAction="#actualiser" 
                       styleClass="btn-refresh"/>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <!-- ScrollPane pour les cartes -->
        <ScrollPane fx:id="scrollPane" 
                   styleClass="cards-scroll" 
                   fitToWidth="true"
                   hbarPolicy="NEVER">
            <VBox fx:id="cardsContainer" 
                 styleClass="cards-container" 
                 spacing="16">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            </VBox>
        </ScrollPane>
    </center>
    
    <bottom>
        <VBox spacing="12" styleClass="content-area">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblMessage" text="✓ Prêt." styleClass="status-message" HBox.hgrow="ALWAYS"/>
                <Button text="✖ Fermer" onAction="#fermerFenetre" styleClass="btn-close"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
