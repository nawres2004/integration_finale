<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.10" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.suivie_nawres.controllers.CalendrierController"
            styleClass="card">
    
    <!-- EN-TÊTE DU CALENDRIER -->
    <top>
        <VBox spacing="12">
            <padding><Insets top="20" right="20" bottom="10" left="20"/></padding>
            
            <!-- Titre -->
            <Label text="📅 Calendrier Médical" styleClass="section-title"/>
            
            <!-- Navigation et actions -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <!-- Navigation mois -->
                <Button text="◀ Précédent" onAction="#moisPrecedent" styleClass="secondary-button"/>
                <Label fx:id="lblMoisAnnee" text="JANVIER 2026" styleClass="calendrier-mois-titre"/>
                <Button text="Suivant ▶" onAction="#moisSuivant" styleClass="secondary-button"/>
                
                <!-- Spacer -->
                <HBox HBox.hgrow="ALWAYS"/>
                
                <!-- Actions -->
                <Button text="📅 Aujourd'hui" onAction="#aujourdhui" styleClass="secondary-button"/>
                <Button text="🔄 Actualiser" onAction="#actualiser" styleClass="secondary-button"/>
                <Button text="➕ Nouveau RDV" onAction="#creerRendezVous" styleClass="primary-button"/>
                <Button text="➕ Nouvelle Consultation" onAction="#creerConsultation" styleClass="primary-button"/>
            </HBox>
            
            <!-- Légende -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Légende:" styleClass="calendrier-legende-titre"/>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="●" styleClass="calendrier-legende-rdv"/>
                    <Label text="Rendez-vous" styleClass="calendrier-legende-texte"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="●" styleClass="calendrier-legende-consultation"/>
                    <Label text="Consultations" styleClass="calendrier-legende-texte"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="●" styleClass="calendrier-legende-mixte"/>
                    <Label text="RDV + Consultations" styleClass="calendrier-legende-texte"/>
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="●" styleClass="calendrier-legende-aujourd-hui"/>
                    <Label text="Aujourd'hui" styleClass="calendrier-legende-texte"/>
                </HBox>
            </HBox>
        </VBox>
    </top>
    
    <!-- CONTENU PRINCIPAL -->
    <center>
        <HBox spacing="20">
            <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>
            
            <!-- GRILLE DU CALENDRIER -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <GridPane fx:id="gridCalendrier" hgap="5" vgap="5" styleClass="calendrier-grille">
                    <!-- Les colonnes seront créées dynamiquement -->
                    <columnConstraints>
                        <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <!-- Les lignes seront créées dynamiquement -->
                    <rowConstraints>
                        <RowConstraints minHeight="40" prefHeight="40" vgrow="NEVER"/>
                        <RowConstraints minHeight="80" prefHeight="80" vgrow="ALWAYS"/>
                        <RowConstraints minHeight="80" prefHeight="80" vgrow="ALWAYS"/>
                        <RowConstraints minHeight="80" prefHeight="80" vgrow="ALWAYS"/>
                        <RowConstraints minHeight="80" prefHeight="80" vgrow="ALWAYS"/>
                        <RowConstraints minHeight="80" prefHeight="80" vgrow="ALWAYS"/>
                        <RowConstraints minHeight="80" prefHeight="80" vgrow="ALWAYS"/>
                    </rowConstraints>
                </GridPane>
            </VBox>
            
            <!-- PANNEAU DE DÉTAILS -->
            <VBox fx:id="vboxDetails" spacing="10" prefWidth="350" minWidth="350" maxWidth="350" 
                  styleClass="calendrier-details" visible="false">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                
                <Label text="Détails du jour" styleClass="calendrier-details-titre"/>
                <Label fx:id="lblDetailsDate" text="Lundi 24 avril 2026" styleClass="calendrier-details-date"/>
                
                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <Label fx:id="lblDetailsContenu" text="Aucun événement" wrapText="true" 
                           styleClass="calendrier-details-contenu"/>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>
