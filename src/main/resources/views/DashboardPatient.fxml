<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.suivie_nawres.controllers.DashboardPatientController">
    <left>
        <VBox prefWidth="290" spacing="16" styleClass="patient-sidebar">
            <padding><Insets bottom="28" left="18" right="18" top="28" /></padding>
            <Label styleClass="patient-logo" text="vita+" />
            <Button maxWidth="1.7976931348623157E308" styleClass="patient-menu-item patient-menu-item-active" text="Suivi Patient" />
            <Button maxWidth="1.7976931348623157E308" styleClass="patient-menu-item" text="Suivi Medical" />
            <Button maxWidth="1.7976931348623157E308" styleClass="patient-menu-item" text="Ordonnances et Medicaments" wrapText="true" />
            <Button maxWidth="1.7976931348623157E308" styleClass="patient-menu-item" text="Blog et Informations" />
            <Button maxWidth="1.7976931348623157E308" styleClass="patient-menu-item" text="Regime Medical" />
            <Button maxWidth="1.7976931348623157E308" styleClass="patient-menu-item" text="Donateurs" />
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" onAction="#retourChoixRole" styleClass="patient-admin-button" text="Changer le role" />
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="patient-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="28" styleClass="patient-wrapper">
                    <padding><Insets bottom="28" left="40" right="40" top="28" /></padding>

                    <HBox alignment="CENTER_RIGHT" spacing="14">
                        <Button onAction="#retourChoixRole" styleClass="patient-top-return" text="Retour roles" />
                        <Button onAction="#voirMesRendezVous" styleClass="patient-top-return" text="Mes Rendez-Vous" />
                        <Button onAction="#demanderRendezVous" styleClass="patient-top-action" text="Reserver un Rendez-Vous" />
                    </HBox>

                    <VBox maxWidth="1220" spacing="14" styleClass="patient-primary-card">
                        <padding><Insets bottom="28" left="36" right="36" top="28" /></padding>

                       <VBox spacing="10" styleClass="patient-header-box">
                           <Label styleClass="patient-main-title" text="Bienvenue dans votre Espace Patient" />
                           <Label styleClass="patient-main-subtitle" text="Gerez vos rendez-vous et consultez votre dossier medical" />
                       </VBox>
                        <Label styleClass="patient-card-title" text="Demande de rendez-vous" />
                        <Label styleClass="patient-card-text" text="Reserve ton rendez-vous puis consulte son statut (EN_ATTENTE, ACCEPTE, REFUSE)." wrapText="true" />
                        <HBox spacing="10">
                            <Button maxWidth="220" onAction="#demanderRendezVous" styleClass="patient-card-button" text="Ouvrir le formulaire" />
                            <Button maxWidth="220" onAction="#voirMesRendezVous" styleClass="patient-card-button" text="Voir mes rendez-vous" />
                        </HBox>
                    </VBox>

                    <StackPane fx:id="contentPane" managed="false" minHeight="320" styleClass="content-area patient-content-host" visible="false" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
