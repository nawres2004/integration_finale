<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ArticleCommentsController"
      stylesheets="@styles.css"
      VBox.vgrow="ALWAYS">

    <!-- TOP BAR -->
    <HBox alignment="CENTER_LEFT" styleClass="topbar" spacing="12">
        <children>
            <Button text="←" onAction="#handleBackToArticles"
                    style="-fx-background-color: #EBF5FB; -fx-text-fill: #0C5283; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 12;"/>
            <Label fx:id="articleTitleLabel" text="Article Comments" styleClass="topbar-title"/>
        </children>
        <padding><Insets left="20" right="20"/></padding>
    </HBox>

    <!-- SCROLLABLE ARTICLE & COMMENTS LIST -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #EBF5FB; -fx-background: #EBF5FB;">
        <content>
            <VBox style="-fx-background-color: #EBF5FB; -fx-padding: 20; -fx-spacing: 20;" fillWidth="true">
                
                <!-- FULL ARTICLE DISPLAY -->
                <HBox styleClass="article-card" style="-fx-pref-width: 9999; -fx-padding: 30;" spacing="20" fillHeight="false" alignment="TOP_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="5">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                        <Label fx:id="fullArticleTitle" styleClass="article-card-title" style="-fx-font-size: 24px; -fx-text-fill: #0C5283;" wrapText="true"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="translateBtn" text="🌍 Traduire en Anglais" onAction="#handleTranslate" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>
                                <Label fx:id="fullArticleDate" styleClass="article-card-date" style="-fx-padding: 5 0 20 0; -fx-font-size: 13px;"/>
                                <Label fx:id="fullArticleContent" styleClass="article-card-content" wrapText="true" style="-fx-font-size: 15px; -fx-text-fill: #333333;"/>
                            </children>
                        </VBox>
                        
                        <!-- QR CODE AREA -->
                        <VBox alignment="TOP_CENTER" spacing="5" style="-fx-background-color: #F8F9FA; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;">
                            <children>
                                <Label text="📱 Scanner" style="-fx-text-fill: #0C5283; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <ImageView fx:id="qrCodeImage" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- COMMENTS HEADER -->
                <Label text="Discussion" styleClass="section-title"/>

                <!-- COMMENTS LIST -->
                <VBox fx:id="commentsContainer" style="-fx-spacing: 12;" fillWidth="true"/>
            </VBox>
        </content>
    </ScrollPane>

    <!-- COMMENT INPUT BAR (hidden for admin via controller) -->
    <VBox fx:id="inputBar" styleClass="comment-input-bar">
        <children>
            <Label text="Write a comment..." style="-fx-text-fill: #0C5283; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <children>
                    <TextArea fx:id="newCommentField"
                              promptText="Share your thoughts..."
                              styleClass="comment-input"
                              wrapText="true"
                              HBox.hgrow="ALWAYS"/>
                    <Button text="Post →" onAction="#handlePostComment"
                            styleClass="btn-primary"
                            style="-fx-pref-height: 80; -fx-font-size: 13px;"/>
                </children>
            </HBox>
            <Label fx:id="commentErrorLabel" styleClass="error-label" visible="false" managed="false"/>
        </children>
    </VBox>
</VBox>
