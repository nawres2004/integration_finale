<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane fx:controller="tn.esprit.controllers.ModernDashboardController"
             xmlns:fx="http://javafx.com/fxml"
             prefWidth="1400" prefHeight="800">
    
    <!-- Container principal -->
    <StackPane fx:id="mainContainer" 
               style="-fx-background-color: #F1F5F9;">
        
        <!-- Message de chargement -->
        <VBox alignment="CENTER" spacing="20">
            <Label text="🏥 Vita+"
                   style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #0066CC;"/>
            <Label text="Chargement du dashboard..."
                   style="-fx-font-size: 18px; -fx-text-fill: #475569;"/>
            <ProgressBar prefWidth="300" 
                           progress="-1" 
                           style="-fx-accent: #0066CC;"/>
        </VBox>
        
    </StackPane>
    
</StackPane>
