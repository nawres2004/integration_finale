<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            stylesheets="@../dashboard.css"
            style="-fx-background-color:#F1F5F9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.frontoffice.FrontProjetsController">

    <!-- TOPBAR -->
    <top>
        <HBox styleClass="topbar" spacing="16" alignment="CENTER_LEFT">
            <Label text="🏥 Vita+" styleClass="logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="topUserLabel" text="💰 Donateur" styleClass="user-name"/>
            <Button text="👤" onAction="#openProfile"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                           -fx-font-size: 18px; -fx-background-radius: 50; -fx-cursor: hand;
                           -fx-pref-width: 38; -fx-pref-height: 38;"/>
            <Button text="🔒" onAction="#openChangePassword"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                           -fx-font-size: 16px; -fx-background-radius: 50; -fx-cursor: hand;
                           -fx-pref-width: 38; -fx-pref-height: 38;"/>
            <Button text="🚪 Déconnexion" styleClass="logout-btn" onAction="#logout"/>
        </HBox>
    </top>

    <center>
        <HBox>
            <!-- SIDEBAR -->
            <VBox styleClass="sidebar" spacing="4" VBox.vgrow="ALWAYS">
                <Label text="🏥 Vita+" styleClass="sidebar-logo"/>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT">
                    <Label text="🏠" styleClass="nav-icon"/>
                    <Label text="Accueil" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT">
                    <Label text="🩺" styleClass="nav-icon"/>
                    <Label text="Suivi Médical" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT">
                    <Label text="�" styleClass="nav-icon"/>
                    <Label text="Ordonnances et Mé..." styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT">
                    <Label text="📝" styleClass="nav-icon"/>
                    <Label text="Blog et Informations" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT">
                    <Label text="🥗" styleClass="nav-icon"/>
                    <Label text="Régime Médical" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item nav-item-active" spacing="14" alignment="CENTER_LEFT">
                    <Label text="💰" styleClass="nav-icon"/>
                    <Label text="Donateurs" styleClass="nav-text"/>
                </HBox>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox styleClass="nav-item logout-item" spacing="14" alignment="CENTER_LEFT"
                      onMouseClicked="#logout" style="-fx-cursor: hand;">
                    <Label text="🚪" styleClass="nav-icon"/>
                    <Label text="Déconnexion" styleClass="nav-text"/>
                </HBox>
            </VBox>

            <!-- CONTENU -->
            <VBox styleClass="main-content" spacing="16" HBox.hgrow="ALWAYS">

                <!-- Titre + bouton Statistiques -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="2">
                        <Label text="Projets" styleClass="page-title"/>
                        <Label text="Découvrez les projets et contribuez par un don"
                               style="-fx-font-size:13px; -fx-text-fill:#64748b;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Statistiques"
                            style="-fx-background-color:#374151; -fx-text-fill:white; -fx-font-weight:bold;
                                   -fx-background-radius:20; -fx-cursor:hand; -fx-padding:9 18 9 18;"
                            onAction="#goToStats"/>
                </HBox>

                <!-- Barre recherche -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="tfRecherche" promptText="Rechercher un projet..."
                               style="-fx-background-radius:20; -fx-border-radius:20; -fx-border-color:#ddd;
                                      -fx-padding:8 14 8 14; -fx-background-color:white; -fx-pref-width:280;"/>
                    <Button text="Rechercher"
                            style="-fx-background-color:#1a73e8; -fx-text-fill:white; -fx-font-weight:bold;
                                   -fx-background-radius:20; -fx-cursor:hand; -fx-padding:9 18 9 18;"
                            onAction="#rechercher"/>
                </HBox>

                <!-- Filtres tri -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ComboBox fx:id="cbTriPar" promptText="Trier par..."
                              style="-fx-background-radius:8; -fx-background-color:white; -fx-pref-width:130;"/>
                    <ComboBox fx:id="cbOrdre" promptText="Ordre..."
                              style="-fx-background-radius:8; -fx-background-color:white; -fx-pref-width:110;"/>
                    <Button text="Appliquer tri"
                            style="-fx-background-color:#1a73e8; -fx-text-fill:white; -fx-font-weight:bold;
                                   -fx-background-radius:20; -fx-cursor:hand; -fx-padding:9 18 9 18;"
                            onAction="#appliquerTri"/>
                    <Button text="Réinitialiser tri"
                            style="-fx-background-color:#374151; -fx-text-fill:white; -fx-font-weight:bold;
                                   -fx-background-radius:20; -fx-cursor:hand; -fx-padding:9 18 9 18;"
                            onAction="#reinitialiser"/>
                </HBox>

                <!-- Cartes projets -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color:transparent; -fx-background:transparent;">
                    <FlowPane fx:id="flowProjets" hgap="16" vgap="16"
                              style="-fx-padding:4; -fx-background-color:transparent;"/>
                </ScrollPane>

            </VBox>
        </HBox>
    </center>

</BorderPane>
