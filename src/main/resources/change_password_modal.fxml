<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.ChangePasswordController"
      spacing="0"
      style="-fx-background-color: white; -fx-background-radius: 16;"
      prefWidth="400">

    <!-- HEADER -->
    <VBox alignment="CENTER" spacing="8"
          style="-fx-background-color: linear-gradient(to bottom right, #0F172A, #1E293B);
                 -fx-background-radius: 16 16 0 0; -fx-padding: 24 20 20 20;">
        <Label text="🔒" style="-fx-font-size: 32px;"/>
        <Label text="Changer le mot de passe"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="userEmailLabel" text=""
               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.6);"/>
    </VBox>

    <!-- FORM -->
    <VBox spacing="12" style="-fx-padding: 24 28 16 28;">

        <!-- Ancien mot de passe -->
        <VBox spacing="4">
            <Label text="Ancien mot de passe"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
            <PasswordField fx:id="oldPassword" promptText="Votre mot de passe actuel"
                           style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10 14 10 14; -fx-font-size: 14px;"/>
            <Label fx:id="errorOld" style="-fx-font-size: 11px; -fx-text-fill: #EF4444;" text=""/>
        </VBox>

        <!-- Nouveau mot de passe -->
        <VBox spacing="4">
            <Label text="Nouveau mot de passe"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
            <PasswordField fx:id="newPassword" promptText="Min. 8 car., 1 maj., 1 chiffre"
                           style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10 14 10 14; -fx-font-size: 14px;"/>
            <Label fx:id="errorNew" style="-fx-font-size: 11px; -fx-text-fill: #EF4444;" text=""/>
        </VBox>

        <!-- Confirmer -->
        <VBox spacing="4">
            <Label text="Confirmer le mot de passe"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
            <PasswordField fx:id="confirmPassword" promptText="Répétez le nouveau mot de passe"
                           style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10 14 10 14; -fx-font-size: 14px;"/>
            <Label fx:id="errorConfirm" style="-fx-font-size: 11px; -fx-text-fill: #EF4444;" text=""/>
        </VBox>

        <!-- Message succès/erreur -->
        <Label fx:id="statusLabel" text="" wrapText="true" maxWidth="340"
               style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- BUTTONS -->
    <HBox spacing="12" alignment="CENTER" style="-fx-padding: 8 28 24 28;">
        <Button text="Annuler" onAction="#cancel" prefWidth="155" prefHeight="40"
                style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-border-color: #E2E8F0; -fx-border-radius: 10;"/>
        <Button text="💾 Mettre à jour" onAction="#save" prefWidth="155" prefHeight="40"
                style="-fx-background-color: linear-gradient(to right, #0066CC, #0099CC);
                       -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 10; -fx-cursor: hand;"/>
    </HBox>

</VBox>
