<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox spacing="20" style="-fx-padding: 24; -fx-background-color:#F1F5F9;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.backoffice.StatistiquesController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Statistiques des projets"
               style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#1e293b;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="← Dashboard"
                style="-fx-background-color:white; -fx-text-fill:#374151; -fx-font-weight:bold;
                       -fx-background-radius:10; -fx-cursor:hand; -fx-padding:8 16; -fx-border-color:#ddd; -fx-border-radius:10;"
                onAction="#goToDashboard"/>
        <Button text="Projets"
                style="-fx-background-color:white; -fx-text-fill:#1a73e8; -fx-font-weight:bold;
                       -fx-background-radius:10; -fx-cursor:hand; -fx-padding:8 16; -fx-border-color:#1a73e8; -fx-border-radius:10;"
                onAction="#goToProjets"/>
        <Button text="Dons"
                style="-fx-background-color:white; -fx-text-fill:#1a73e8; -fx-font-weight:bold;
                       -fx-background-radius:10; -fx-cursor:hand; -fx-padding:8 16; -fx-border-color:#1a73e8; -fx-border-radius:10;"
                onAction="#goToDons"/>
    </HBox>

    <HBox spacing="16">
        <VBox style="-fx-background-color:white; -fx-background-radius:12; -fx-padding:20;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,3);"
              HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
            <Label text="Total collecté" style="-fx-font-size:12px; -fx-text-fill:#888;"/>
            <Label fx:id="lblTotalCollecte" text="0 DT"
                   style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#1a73e8;"/>
        </VBox>
        <VBox style="-fx-background-color:white; -fx-background-radius:12; -fx-padding:20;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,3);"
              HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
            <Label text="Total objectifs" style="-fx-font-size:12px; -fx-text-fill:#888;"/>
            <Label fx:id="lblTotalObjectif" text="0 DT"
                   style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#e53935;"/>
        </VBox>
        <VBox style="-fx-background-color:white; -fx-background-radius:12; -fx-padding:20;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,3);"
              HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
            <Label text="Progression globale" style="-fx-font-size:12px; -fx-text-fill:#888;"/>
            <Label fx:id="lblProgression" text="0%"
                   style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#2e7d32;"/>
        </VBox>
    </HBox>

    <VBox style="-fx-background-color:white; -fx-background-radius:12; -fx-padding:20;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,3);"
          VBox.vgrow="ALWAYS" spacing="8">
        <Label text="Collecté vs Objectif par projet"
               style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#333;"/>
        <BarChart fx:id="barChart" prefHeight="320" animated="true">
            <xAxis><CategoryAxis label="Projets"/></xAxis>
            <yAxis><NumberAxis label="Montant (DT)"/></yAxis>
        </BarChart>
    </VBox>

</VBox>
