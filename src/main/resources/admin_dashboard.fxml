<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.AdminDashboardController"
            prefWidth="1280" prefHeight="800"
            stylesheets="@dashboard.css">

    <!-- TOPBAR -->
    <top>
        <HBox styleClass="topbar" spacing="16" alignment="CENTER_LEFT">
            <Label text="🏥 Vita+" styleClass="logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="topUserLabel" text="👤 Admin" styleClass="user-name"/>
            <Button text="👤" onAction="#openProfile"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                           -fx-font-size: 18px; -fx-background-radius: 50; -fx-cursor: hand;
                           -fx-pref-width: 38; -fx-pref-height: 38;"/>
            <Button text="🔒" onAction="#openChangePassword"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                           -fx-font-size: 16px; -fx-background-radius: 50; -fx-cursor: hand;
                           -fx-pref-width: 38; -fx-pref-height: 38;"/>
            <Button text="🚪 Déconnexion" styleClass="logout-btn" onAction="#logout"/>
        </HBox>
    </top>

    <center>
        <HBox>
            <!-- SIDEBAR -->
            <VBox styleClass="sidebar" spacing="4">
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT" onMouseClicked="#showDashboard" style="-fx-cursor: hand;">
                    <Label text="📊" styleClass="nav-icon"/>
                    <Label text="Dashboard" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT" onMouseClicked="#scrollToUsers" style="-fx-cursor: hand;">
                    <Label text="👥" styleClass="nav-icon"/>
                    <Label text="Utilisateurs" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT">
                    <Label text="🩺" styleClass="nav-icon"/>
                    <Label text="Validation Médecins" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT">
                    <Label text="📅" styleClass="nav-icon"/>
                    <Label text="Rendez-vous" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT" onMouseClicked="#openOrdonnances">
                    <Label text="📄" styleClass="nav-icon"/>
                    <Label text="Ordonnances" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT" onMouseClicked="#openMedicaments">
                    <Label text="💊" styleClass="nav-icon"/>
                    <Label text="Médicaments" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT" onMouseClicked="#openDonsProjets" style="-fx-cursor: hand;">
                    <Label text="💰" styleClass="nav-icon"/>
                    <Label text="Dons &amp; Projets" styleClass="nav-text"/>
                </HBox>
                <HBox styleClass="nav-item" spacing="14" alignment="CENTER_LEFT" onMouseClicked="#openBlogEtInformations">
                    <Label text="📝" styleClass="nav-icon"/>
                    <Label text="Blog et Informations" styleClass="nav-text"/>
                </HBox>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox styleClass="nav-item logout-item" spacing="14" alignment="CENTER_LEFT"
                      onMouseClicked="#logout">
                    <Label text="🚪" styleClass="nav-icon"/>
                    <Label text="Déconnexion" styleClass="nav-text"/>
                </HBox>
            </VBox>

            <!-- MAIN CONTENT -->
            <ScrollPane fx:id="mainContent" fitToWidth="true" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #F1F5F9; -fx-background: #F1F5F9;">
                <StackPane fx:id="contentPane">
                    <VBox styleClass="main-content" spacing="20">

                    <Label text="📊 Tableau de Bord Administrateur" styleClass="page-title"/>

                    <!-- PROFIL -->
                    <VBox styleClass="content-card" spacing="10">
                        <Label text="👤 Mon Profil" styleClass="section-title"/>
                        <HBox spacing="30" alignment="CENTER_LEFT">
                            <VBox spacing="4">
                                <Label text="Nom:" styleClass="profile-label"/>
                                <Label fx:id="nomLabel" text="-" styleClass="profile-value"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Prénom:" styleClass="profile-label"/>
                                <Label fx:id="prenomLabel" text="-" styleClass="profile-value"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Email:" styleClass="profile-label"/>
                                <Label fx:id="emailLabel" text="-" styleClass="profile-value"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Téléphone:" styleClass="profile-label"/>
                                <Label fx:id="telephoneLabel" text="-" styleClass="profile-value"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Rôle:" styleClass="profile-label"/>
                                <Label fx:id="roleLabel" text="-" styleClass="profile-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- STATS -->
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <VBox styleClass="stat-card" onMouseClicked="#scrollToUsers" style="-fx-cursor: hand;">
                            <Label text="👥" styleClass="stat-icon"/>
                            <Label text="Utilisateurs" styleClass="stat-value"/>
                            <Label text="Total" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card">
                            <Label text="🩺" styleClass="stat-icon"/>
                            <Label text="Médecins" styleClass="stat-value"/>
                            <Label text="Actifs" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card">
                            <Label text="⏳" styleClass="stat-icon"/>
                            <Label text="En attente" styleClass="stat-value"/>
                            <Label text="Validation" styleClass="stat-label"/>
                        </VBox>
                        <VBox styleClass="stat-card">
                            <Label text="🏥" styleClass="stat-icon"/>
                            <Label text="Patients" styleClass="stat-value"/>
                            <Label text="Inscrits" styleClass="stat-label"/>
                        </VBox>
                    </HBox>

                    <!-- TABLEAU TOUS LES UTILISATEURS -->
                    <VBox fx:id="usersSection" styleClass="content-card" spacing="12">
                        <Label text="👥 Gestion des Utilisateurs" styleClass="section-title"/>

                        <!-- Barre recherche + refresh -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField"
                                       promptText="🔍 Rechercher par nom, prénom ou email..."
                                       prefWidth="340"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 8 12 8 12; -fx-font-size: 13px;"/>
                            <Button text="🔄 Rafraîchir" onAction="#refreshTable"
                                    style="-fx-background-color: #0066CC; -fx-text-fill: white;
                                           -fx-background-radius: 8; -fx-font-size: 13px;
                                           -fx-cursor: hand; -fx-padding: 8 16 8 16;"/>
                        </HBox>

                        <Label text="🩺 Médecins → Accepter / Refuser  |  Autres → Activer / Désactiver"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
                            <content>
                                <FlowPane fx:id="cardsContainer" hgap="20" vgap="20" style="-fx-padding: 10;" />
                            </content>
                        </ScrollPane>

                        <Label fx:id="tableStatusLabel" style="-fx-font-size: 13px;"/>
                    </VBox>

                </VBox>
                </StackPane>
            </ScrollPane>
        </HBox>
    </center>

</BorderPane>
