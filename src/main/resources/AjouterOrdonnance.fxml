<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AjouterOrdonnanceController">
    <padding>
        <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
    </padding>

    <children>
        <Label text="Nouvelle Ordonnance" textFill="#0EA5E9">
            <font><Font name="System Bold" size="32.0" /></font>
        </Label>

        <VBox spacing="15.0" styleClass="card">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            <children>
                <Label text="Date de l'ordonnance" textFill="#34495e"><font><Font name="System Bold" size="14.0" /></font></Label>
                <DatePicker fx:id="datePicker" maxWidth="Infinity" />

                <Label text="Durée du traitement" textFill="#34495e"><font><Font name="System Bold" size="14.0" /></font></Label>
                <TextField fx:id="dureeField" promptText="Ex: 10 jours, 1 mois..." />

                <Label text="Instructions" textFill="#34495e"><font><Font name="System Bold" size="14.0" /></font></Label>
                <TextArea fx:id="instructionsArea" prefHeight="120.0" promptText="Précisez la posologie et les conseils..." />

                <Label text="Patient / Utilisateur" textFill="#34495e"><font><Font name="System Bold" size="14.0" /></font></Label>
                <ComboBox fx:id="userCombo" maxWidth="Infinity" promptText="Sélectionnez un patient" />

                <HBox spacing="15.0">
                    <VBox.margin><Insets top="20.0" /></VBox.margin>
                    <children>
                        <Button onAction="#handleAjouter" prefHeight="45.0" prefWidth="160.0" styleClass="btn-primary" text="💾 Enregistrer" />

                        <Button onAction="#showList" prefHeight="45.0" prefWidth="160.0" styleClass="btn-secondary" text="⬅ Retour" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
