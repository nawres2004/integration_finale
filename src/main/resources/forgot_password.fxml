<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="900" prefHeight="560"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.ForgotPasswordController"
            stylesheets="@style.css">

    <HBox prefWidth="900" prefHeight="560">

        <!-- LEFT PANEL -->
        <VBox prefWidth="380" alignment="CENTER" styleClass="left-panel" spacing="16">
            <Label text="🏥 VitaPlus" styleClass="logo"/>
            <Label text="Mot de passe oublié ?" styleClass="subtitle"/>
            <Label text="Suivez les étapes pour" styleClass="subtitle"/>
            <Label text="réinitialiser votre accès." styleClass="subtitle"/>
        </VBox>

        <!-- RIGHT PANEL -->
        <VBox prefWidth="520" alignment="CENTER"
              style="-fx-padding: 40; -fx-background-color: #F1F5F9;">

            <!-- ══ ÉTAPE 1 : EMAIL ══ -->
            <VBox fx:id="stepEmail" alignment="CENTER" spacing="10" styleClass="card">
                <Label text="📧 Étape 1 / 3 — Votre email"
                       style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                <Label text="Réinitialisation" styleClass="title"/>
                <Label text="Entrez votre email pour recevoir un code de vérification."
                       wrapText="true" maxWidth="280"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748B; -fx-text-alignment: center;"/>

                <TextField fx:id="emailField" promptText="votre@email.com"
                           styleClass="input" maxWidth="280"/>
                <Label fx:id="errorEmail" styleClass="field-error" maxWidth="280" wrapText="true"/>

                <Button fx:id="sendCodeBtn" text="📧 Envoyer le code"
                        onAction="#sendCode" styleClass="btn-primary" prefWidth="220"/>

                <Label fx:id="infoEmail" wrapText="true" maxWidth="280"
                       style="-fx-font-size: 12px; -fx-text-fill: #22C55E;"/>

                <Hyperlink text="← Retour à la connexion" onAction="#goToLogin"/>
            </VBox>

            <!-- ══ ÉTAPE 2 : CODE ══ -->
            <VBox fx:id="stepCode" alignment="CENTER" spacing="10" styleClass="card"
                  visible="false" managed="false">
                <Label text="🔢 Étape 2 / 3 — Vérification"
                       style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                <Label text="Code reçu" styleClass="title"/>
                <Label fx:id="emailSentLabel" text=""
                       style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>

                <TextField fx:id="codeField" promptText="_ _ _ _ _ _"
                           styleClass="input" maxWidth="200"
                           style="-fx-font-size: 26px; -fx-text-alignment: center;
                                  -fx-letter-spacing: 6px; -fx-pref-height: 52px;"/>
                <Label fx:id="errorCode" styleClass="field-error" maxWidth="280" wrapText="true"/>

                <Button text="✅ Vérifier" onAction="#verifyCode"
                        styleClass="btn-primary" prefWidth="220"/>

                <HBox spacing="16" alignment="CENTER">
                    <Button fx:id="resendBtn" text="Renvoyer le code"
                            onAction="#resendCode"
                            style="-fx-background-color: transparent; -fx-text-fill: #0066CC;
                                   -fx-font-size: 12px; -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Hyperlink text="← Retour" onAction="#backToEmail"
                               style="-fx-font-size: 12px;"/>
                </HBox>
            </VBox>

            <!-- ══ ÉTAPE 3 : NOUVEAU MOT DE PASSE ══ -->
            <VBox fx:id="stepNewPassword" alignment="CENTER" spacing="8" styleClass="card"
                  visible="false" managed="false">
                <Label text="🔑 Étape 3 / 3 — Nouveau mot de passe"
                       style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                <Label text="Nouveau mot de passe" styleClass="title"/>
                <Label text="Min. 8 caractères, 1 majuscule, 1 chiffre."
                       style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>

                <PasswordField fx:id="newPassField" promptText="Nouveau mot de passe"
                               styleClass="input" maxWidth="280"/>
                <Label fx:id="errorNewPass" styleClass="field-error" maxWidth="280" wrapText="true"/>

                <PasswordField fx:id="confirmPassField" promptText="Confirmer le mot de passe"
                               styleClass="input" maxWidth="280"/>
                <Label fx:id="errorConfirmPass" styleClass="field-error" maxWidth="280" wrapText="true"/>

                <Button text="💾 Réinitialiser" onAction="#resetPassword"
                        styleClass="btn-primary" prefWidth="220"/>

                <Label fx:id="successLabel" wrapText="true" maxWidth="280"
                       style="-fx-font-size: 13px;"/>
            </VBox>

        </VBox>
    </HBox>

</AnchorPane>
